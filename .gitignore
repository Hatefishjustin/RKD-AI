__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
.env

# Local runtime state. Source fixtures remain read-only and are never stored here.
var/
web/dist/
web/.vite/
web/*.tsbuildinfo
.build_xlsx/

# WorkBuddy local tool state (session memory, caches) — not project source
.workbuddy/

# Temporary handover status snapshots (not source)
tmp/接管-git-status*.txt

# Portable tool binaries (Blender, ~1.3 GB) — kept on disk, never in Git
tools/blender/

# Working screenshots / crops / logs
tmp/*.png
tmp/*.log
# Headless-Edge scratch profiles
tmp/edgeprof*/
tmp/edgeshot*/
