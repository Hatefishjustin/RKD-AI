__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
.env

# Local runtime state. Source fixtures remain read-only and are never stored here.
var/
web/dist/
web/.vite/
web/*.tsbuildinfo
.build_xlsx/

# WorkBuddy local tool state (session memory, caches) — not project source
.workbuddy/

# Temporary handover status snapshots (not source)
tmp/接管-git-status*.txt

# Portable tool binaries and CC0 assets (Blender ~1.3 GB, assets ~35 MB) — kept on disk, never in Git
tools/blender/
tools/assets/

# Working screenshots / crops / logs
tmp/*.png
tmp/*.log
# Headless-Edge scratch profiles
tmp/edgeprof*/
tmp/edgeshot*/
# Scratch render/test output
tmp/shots/
tmp/ph/
tmp/debug/
tmp/*.py
