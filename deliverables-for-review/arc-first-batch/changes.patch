+            "tradeoffs": ["主展台居中，四周都能看" if option == "A" else "主轴清晰，序列感强",
+                          "环游占掉较多通道面积" if option == "A" else "横向分格较多"],
+            "non_orthogonal": [f"{zones[0]['id']}:入口斜切品牌墙", "P1:三级圆角中岛"],
+        },
+        "zones": zones,
+        "circulation": [{"id": f"C{option}1", "width_mm": 2000,
