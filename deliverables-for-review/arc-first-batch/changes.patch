+        {"id": "ZA4", "name": "南生活场景", "role": "scene",
+         "polygon": [[5400, 1800], [20400, 1800], [20400, 5200], [5400, 5200]]},
+        {"id": "ZA5", "name": "东洽谈", "role": "meeting",
