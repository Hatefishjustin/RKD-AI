+}
+
+REQUIREMENT = {
+    "text": "这是我们集团的样品展厅，要做成能带客户看、能坐下来谈的地方，不要像仓库摆货。"
+            "第一眼进来要看到品牌，然后要有一条能一路看过去的产品序列，中间要有一个能停下来的重点。"
+            "客户来谈事要有安静的洽谈空间。前台和茶水要有，楼梯和卫生间保留不动。",
+    "must_have": ["品牌第一眼", "产品序列", "一个可以停下来的重点展台", "洽谈空间",
+                  "前台接待 + 茶水服务", "保留楼梯与卫生间"],
