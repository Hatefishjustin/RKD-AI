+        {"id": "ZA1", "name": "品牌序厅", "role": "arrival",
+         "polygon": [[0, 8600], [5400, 8600], [5400, 13500], [1600, 13500], [0, 11900]]},
+        {"id": "ZA2", "name": "中央中岛", "role": "island",
