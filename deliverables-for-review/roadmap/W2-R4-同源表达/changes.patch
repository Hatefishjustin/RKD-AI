+            changes = evidence / "outputs" / "changes"
+            base_pkg = build_package(model, project_id=PID, option_revision_id="r4-fixture",
+                                     settings={"presentation": pres,
+                                               "material_unit_prices": prices},
+                                     finish_scope=scope)
+            # 1) 改一个窗洞口尺寸
+            p1 = copy.deepcopy(pres)
+            for op in p1["openings"]:
+                if op["object_id"] == "R4-WIN-N1":
+                    op["width_mm"] = 3000.0
+            p1 = normalize_presentation(p1, boundary_mm=boundary)
+            pkg1 = build_package(model, project_id=PID, option_revision_id="r4-fixture",
+                                 settings={"presentation": p1,
+                                           "material_unit_prices": prices},
+                                 finish_scope=scope)
+            scene1 = pkg1["scene"]
+            open1 = next(o for o in scene1["enclosure"]["openings"]
+                         if o["object_id"] == "R4-WIN-N1")
+            ok1 = (pkg1["plan"] != base_pkg["plan"] and pkg1["scene"] != base_pkg["scene"]
+                   and open1["width_mm"] == 3000.0
+                   and "R4-WIN-N1" in pkg1["plan"].decode("utf-8")
+                   and "3000×1800" in pkg1["plan"].decode("utf-8")
+                   and pkg1["quantities"] == base_pkg["quantities"])
+            # 2) 换一项材质贴图
+            p2 = copy.deepcopy(pres)
+            for mat in p2["materials"]:
+                if mat["material_id"] == "mat-oak":
+                    mat["slot"] = "walnut"
+                    mat["name"] = "玫瑰木（受控替换）"
+            p2 = normalize_presentation(p2, boundary_mm=boundary)
+            pkg2 = build_package(model, project_id=PID, option_revision_id="r4-fixture",
+                                 settings={"presentation": p2,
+                                           "material_unit_prices": prices},
+                                 finish_scope=scope)
+            arrival_slot = next(z["material_slot"] for z in pkg2["scene"]["zones"]
+                                if z["object_id"] == "ZA1")
+            ok2 = (arrival_slot == "walnut" and pkg2["plan"] != base_pkg["plan"]
+                   and pkg2["scene"] != base_pkg["scene"]
+                   and pkg2["quantities"] == base_pkg["quantities"]
+                   and pkg2["cost"] == base_pkg["cost"])
+            # 3) 只改相机
+            p3 = copy.deepcopy(pres)
+            p3["cameras"][0]["position_mm"][0] += 3000.0
+            p3 = normalize_presentation(p3, boundary_mm=boundary)
+            pkg3 = build_package(model, project_id=PID, option_revision_id="r4-fixture",
+                                 settings={"presentation": p3,
+                                           "material_unit_prices": prices},
+                                 finish_scope=scope)
+            ok3 = (pkg3["plan"] != base_pkg["plan"] and pkg3["scene"] != base_pkg["scene"]
+                   and pkg3["quantities"] == base_pkg["quantities"]
+                   and pkg3["cost"] == base_pkg["cost"])
+            # 4) 只改假设单价
+            pkg4 = build_package(model, project_id=PID, option_revision_id="r4-fixture",
+                                 settings={"presentation": pres,
+                                           "material_unit_prices": {k: v * 1.2
+                                                                    for k, v in prices.items()}},
+                                 finish_scope=scope)
+            amount0 = base_pkg["cost"]["assumption_trial_total_cny"]
+            amount4 = pkg4["cost"]["assumption_trial_total_cny"]
+            ok4 = (pkg4["plan"] == base_pkg["plan"] and pkg4["scene"] == base_pkg["scene"]
+                   and pkg4["quantities"] == base_pkg["quantities"]
+                   and amount0 and amount4 and amount4 > amount0)
+            check("R4-05", "四项受控变更：开口尺寸同步平面/场景且改几何不改量；换材质可追踪；"
+                           "只改相机不改量；只改单价不改几何",
+                  bool(ok1 and ok2 and ok3 and ok4),
+                  {"opening_width_mm": open1["width_mm"],
+                   "opening_quantity_unchanged": pkg1["quantities"] == base_pkg["quantities"],
+                   "material_slot_after": arrival_slot,
+                   "material_quantity_and_cost_unchanged":
+                       pkg2["quantities"] == base_pkg["quantities"]
+                       and pkg2["cost"] == base_pkg["cost"],
+                   "camera_quantity_unchanged": pkg3["quantities"] == base_pkg["quantities"],
+                   "price_geometry_unchanged": pkg4["quantities"] == base_pkg["quantities"]
+                   and pkg4["plan"] == base_pkg["plan"],
+                   "trial_amount_before_after": [amount0, amount4]})
+            changes.mkdir(parents=True, exist_ok=True)
+            (changes / "reconciliation.json").write_text(json.dumps({
+                "zone_to_material": [{"zone_id": z["object_id"],
+                                      "role": z.get("role"),
+                                      "material_slot": z.get("material_slot")}
+                                     for z in base_pkg["scene"]["zones"]],
+                "material_groups": next(x for x in base_pkg["quantities"]["items"]
+                                        if x["quantity_id"] == "Q-FLOOR-FINISH")["material_groups"],
+                "trial_items": base_pkg["cost"]["known_items"],
+                "trial_total_cny": amount0,
+                "note": "材料面切片 → 材料编号 → CC0 贴图 slot → 分组面积 → 假设单价试算，逐行可追踪",
+            }, ensure_ascii=False, indent=2), encoding="utf-8")
+        else:
+            check("R4-05", "四项受控变更", False, {"reason": "布局 A 未产出模型"})
+
+        # ---------------------------------------------------------- 入口小修
+        conflict_evidence = evidence / "after" / "finish-conflict-after.json"
+        regression_evidence = (evidence / "regression-second-closeout"
+                               / "repro-r4-regression.json")
+        conflict_ok = False
+        if conflict_evidence.is_file():
+            payload = json.loads(conflict_evidence.read_text(encoding="utf-8"))
+            conflict_ok = bool(payload.get("all_as_expected") and payload.get("label") == "after")
+        regression_ok = False
+        if regression_evidence.is_file():
+            payload = json.loads(regression_evidence.read_text(encoding="utf-8"))
+            regression_ok = (payload.get("totals", {}).get("observed_pass") == 15
+                             and payload.get("totals", {}).get("observed_fail") == 0)
+        check("R4-06", "入口小修：同层异材冲突不产 known 总量/试算；原 15 项回归保留",
+              bool(conflict_ok and regression_ok),
+              {"conflict_after": str(conflict_evidence), "conflict_all_as_expected": conflict_ok,
+               "regression": str(regression_evidence), "regression_15_of_15": regression_ok})
+
+        # ------------------------------------------ 按 ID 任务定位（不串成果）
+        if a and b:
+            ja, jb = a["job"]["job_id"], b["job"]["job_id"]
+            sa = http("GET", f"{base}/spatial-outputs?job_id={ja}")[1]
+            sb = http("GET", f"{base}/spatial-outputs?job_id={jb}")[1]
+            rid_a = (a["revision"] or {}).get("production_revision_id")
+            rid_b = (b["revision"] or {}).get("production_revision_id")
+            check("R4-07", "按 job_id 查询只返回该任务的 revision/artifacts，不串另一布局",
+                  bool((sa.get("job") or {}).get("job_id") == ja
+                       and (sb.get("job") or {}).get("job_id") == jb
+                       and (sa.get("revision") or {}).get("production_revision_id") == rid_a
+                       and (sb.get("revision") or {}).get("production_revision_id") == rid_b
+                       and rid_a != rid_b),
+                  {"job_a": ja, "job_b": jb, "revision_a": rid_a, "revision_b": rid_b})
+        else:
+            check("R4-07", "按 job_id 任务定位", False, {"reason": "缺少任务"})
+
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(5)
+        main_store.close()
+
+    # ---------------------------------------- 取消晚到 / 任务定位回归（同一 R4 代码）
+    import w2_closeout_repro as base_repro  # noqa: E402
+    import w2_second_closeout_repro as second  # noqa: E402
+    stack = base_repro.Stack(runtime / "regression-stack")
+    try:
+        ok_cancel, ev_cancel = second.c2_cancel_in_gap(stack)
+        ok_locate, ev_locate = second.c3_explicit_isolated(stack)
+    finally:
+        stack.close()
+    check("R4-08", "同一 R4 服务代码：取消晚到不复活可显式重试；失败任务不借用他人成果",
+          bool(ok_cancel and ok_locate),
+          {"cancel_late": ev_cancel, "job_isolation": ev_locate})
+
+    failed = sum(1 for c in CHECKS if c["result"] != "observed_pass")
+    code_head = __import__("subprocess").run(
+        ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
+        capture_output=True, text=True).stdout.strip()
+    out = {
+        "task_id": "W2-R4 同源表达",
+        "schema_version": "rkd-w2-r4-checks.v1",
+        "executed_at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
+        "code_head": code_head,
+        "render_enabled": not args.no_render,
+        "environment": {"python": sys.version.split()[0],
+                        "renderer": "blender-4.2.9 Cycles CPU (local CC0 assets)"
+                        if not args.no_render else "not_run",
+                        "isolated_main_db": str(main_db),
+                        "isolated_studio_db": str(studio_db),
+                        "model_channel": "labelled local fixtures only",
+                        "presentation": "executor manual test assumptions",
+                        "keys_used": False},
+        "checks": CHECKS,
+        "totals": {"observed_pass": len(CHECKS) - failed, "observed_fail": failed},
+        "external_calls": 0, "tokens": 0, "images_generated": (0 if args.no_render
+                                                               else len(meta_all)),
+        "cost_amount_or_null": None,
+        "cost_status": "no_external_calls_zero_cost",
+        "not_customer_design_approval": True,
+    }
+    (evidence / "checks.json").write_text(json.dumps(out, ensure_ascii=False, indent=2),
+                                          encoding="utf-8")
+    print(json.dumps({"passed": len(CHECKS) - failed, "failed": failed,
+                      "out": str(evidence / "checks.json")}, ensure_ascii=False))
+    return 0 if failed == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/verify_w2_r4_browser.cjs b/scripts/verify_w2_r4_browser.cjs
new file mode 100644
index 0000000..86a773c
--- /dev/null
+++ b/scripts/verify_w2_r4_browser.cjs
@@ -0,0 +1,141 @@
+/* W2-R4 真实浏览器验收：页面只读展示已登记成果 + 两份平面 SVG 渲染预览。
+   0 外部调用。由 verify_w2_r4_browser.py 驱动。 */
+const fs = require('node:fs');
+const path = require('node:path');
+const os = require('node:os');
+const assert = require('node:assert/strict');
+const { pathToFileURL } = require('node:url');
+const crypto = require('node:crypto');
+const { chromium } = require(path.join(os.homedir(), '.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright'));
+
+const url = process.env.RKD_QA_URL;
+const evidence = process.env.RKD_QA_EVIDENCE_DIR;
+const projectId = process.env.RKD_QA_PROJECT_ID;
+const outputsDir = process.env.RKD_QA_OUTPUTS_DIR;
+assert(url && evidence && projectId && outputsDir, 'isolated W2-R4 browser config required');
+
+(async () => {
+  const browser = await chromium.launch({ channel: 'msedge', headless: true });
+  const page = await browser.newPage({ viewport: { width: 1500, height: 1050 } });
+  const errors = [];
+  page.on('pageerror', e => errors.push('pageerror: ' + e.message));
+  page.on('console', m => {
+    if (m.type() !== 'error') return;
+    const t = m.text();
+    if (/Failed to load resource.*404|status of 404/.test(t)) return;
+    errors.push('console: ' + t);
+  });
+  page.on('dialog', async d => { await d.accept('W2-R4'); });
+  const obs = {};
+  try {
+    await page.goto(url, { waitUntil: 'domcontentloaded' });
+    await page.locator('.project-item').first().waitFor({ timeout: 25000 });
+    await page.locator('.project-item').first().click();
+    await page.locator('.view-tabs button').filter({ hasText: '需求草稿' }).click();
+    await page.locator('.design-modes button').filter({ hasText: '同源成果' }).click();
+
+    await page.locator('[data-testid="spatial-plan"]').waitFor({ timeout: 90000 });
+    await page.locator('[data-testid="spatial-render"]').waitFor({ timeout: 90000 });
+    const status = await (await page.request.get(
+      `${url}/api/v1/projects/${projectId}/ai/spatial-outputs`)).json();
+    obs.job_status = status.job?.status;
+    obs.production_revision_id = status.revision?.production_revision_id;
+    obs.artifact_names = (status.artifacts || []).map(a => a.filename);
+    obs.baseline_generator = status.revision?.baseline?.generator_version;
+    obs.baseline_presentation_assumption = status.revision?.baseline?.presentation_assumption;
+    obs.package_missing_head = (status.revision?.package?.missing || []).slice(0, 3);
+    assert(status.artifacts.some(a => a.filename === 'plan.svg'));
+    assert(status.artifacts.some(a => a.filename === 'package.zip'));
+    assert(obs.baseline_presentation_assumption === true,
+      'page is not showing the R4 presentation-fixture output');
+
+    const planSrc = await page.locator('[data-testid="spatial-plan"]').getAttribute('src');
+    const renderSrc = await page.locator('[data-testid="spatial-render"]').getAttribute('src');
+    obs.plan_is_blob = Boolean(planSrc && planSrc.startsWith('blob:'));
+    obs.render_is_blob = Boolean(renderSrc && renderSrc.startsWith('blob:'));
+    assert(obs.plan_is_blob && obs.render_is_blob);
+
+    const qRows = await page.locator('[data-testid="spatial-quantities"] tbody tr').count();
+    obs.quantity_rows = qRows;
+    const panelText = await page.locator('.ai-spatial-panel').innerText();
+    obs.panel_has_missing = /缺项/.test(panelText);
+    obs.panel_has_unknown = /unknown/.test(panelText);
+    obs.panel_has_trial = /试算|假设单价/.test(panelText);
+    obs.panel_has_boundary = /不是报价|内部评审|非现场事实|人工/.test(panelText);
+    assert(qRows >= 5, 'quantity table not visible');
+    assert(obs.panel_has_missing && obs.panel_has_trial && obs.panel_has_boundary,
+      'missing items / trial basis / boundary not visible');
+
+    const base = `${url}/api/v1/projects/${projectId}/ai/spatial-outputs/${obs.production_revision_id}/files`;
+    const downloads = {};
+    for (const name of ['plan.svg', 'render.png', 'package.zip']) {
+      const r = await page.request.get(`${base}/${name}`);
+      const buf = await r.body();
+      downloads[name] = { status: r.status(), bytes: buf.length,
+        sha256: crypto.createHash('sha256').update(buf).digest('hex') };
+      assert.equal(r.status(), 200, `${name} download failed`);
+      assert(buf.length > 1000, `${name} too small`);
+    }
+    obs.downloads = downloads;
+    const manifest = await (await page.request.get(`${base}/manifest.json`)).json();
+    const registered = Object.fromEntries(manifest.files.map(f => [f.filename, f.sha256]));
+    obs.manifest_sha_match = ['plan.svg', 'render.png'].every(
+      n => registered[n] && registered[n] === downloads[n].sha256);
+    obs.zip_sha_match = (status.artifacts.find(a => a.filename === 'package.zip') || {}).sha256
+      === downloads['package.zip'].sha256;
+    assert(obs.manifest_sha_match && obs.zip_sha_match, 'download bytes do not match registered sha256');
+
+    await page.screenshot({ path: path.join(evidence, 'r4-outputs-desktop.png'), fullPage: true });
+    await page.setViewportSize({ width: 390, height: 844 });
+    await page.waitForTimeout(800);
+    obs.mobile_scroll_width = await page.evaluate(() => document.documentElement.scrollWidth);
+    obs.mobile_overflow_elements = await page.evaluate(() => {
+      const out = [];
+      for (const el of document.querySelectorAll('*')) {
+        const r = el.getBoundingClientRect();
+        if (r.right > 391 && r.width > 0) {
+          out.push({ tag: el.tagName, cls: String(el.className || '').slice(0, 60),
+            text: String(el.textContent || '').trim().slice(0, 70),
+            right: Math.round(r.right), width: Math.round(r.width) });
+        }
+      }
+      return out.slice(0, 25);
+    });
+    assert(obs.mobile_scroll_width <= 390, `mobile overflow: ${obs.mobile_scroll_width}`);
+    await page.screenshot({ path: path.join(evidence, 'r4-outputs-mobile.png'), fullPage: true });
+
+    // 把两布局的平面 SVG 各渲染成 PNG，供人工目检文字/尺寸/重叠
+    const svgPage = await browser.newPage({ viewport: { width: 1400, height: 1100 } });
+    obs.plan_previews = [];
+    for (const letter of ['A', 'B']) {
+      const svgPath = path.join(outputsDir, `layout-${letter}`, 'plan.svg');
+      if (!fs.existsSync(svgPath)) continue;
+      await svgPage.goto(pathToFileURL(svgPath).href, { waitUntil: 'load' });
+      await svgPage.waitForTimeout(500);
+      const out = path.join(evidence, `plan-preview-${letter}.png`);
+      // SVG 作为独立文档打开时 fullPage 会因 viewBox 计算超时；视口已大于图幅
+      await svgPage.screenshot({ path: out, timeout: 60000 });
+      obs.plan_previews.push({ layout: letter, file: path.basename(out),
+        bytes: fs.statSync(out).size });
+    }
+    await svgPage.close();
+    assert(obs.plan_previews.length === 2, 'both plan previews are required');
+
+    obs.page_errors = errors;
+    assert.equal(errors.length, 0, 'browser JS errors: ' + errors.join(' | '));
+    obs.passed = true;
+    fs.writeFileSync(path.join(evidence, 'browser-observations.json'), JSON.stringify(obs, null, 2));
+    console.log(JSON.stringify({ passed: true, quantities: qRows,
+      downloads: Object.keys(downloads), previews: obs.plan_previews.length }, null, 2));
+    await browser.close();
+    process.exit(0);
+  } catch (e) {
+    obs.passed = false;
+    obs.failure = String((e && e.message) || e);
+    obs.page_errors = errors;
+    fs.writeFileSync(path.join(evidence, 'browser-observations.json'), JSON.stringify(obs, null, 2));
+    console.error(String((e && e.stack) || e));
+    await browser.close();
+    process.exit(1);
+  }
+})();
