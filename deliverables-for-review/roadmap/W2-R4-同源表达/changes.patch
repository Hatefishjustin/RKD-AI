+            "wall_object_id": "R4-W-N",
+            "center_mm": [round((start + end) / 2, 1), H],
+            "width_mm": round(end - start, 1), "height_mm": 1800, "sill_mm": 900,
+            "source": "manual_test_assumption:stage1_window_rhythm_as_pattern_only",
