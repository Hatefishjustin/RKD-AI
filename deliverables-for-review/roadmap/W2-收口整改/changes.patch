+    xs = sorted({float(p[0]) for poly in polys + holes for p in poly})
+    total = 0.0
+    for a, b in zip(xs, xs[1:]):
+        if b - a <= 0:
+            continue
+        mid = (a + b) / 2.0
+        inside: list[tuple[float, float]] = []
+        for poly in polys:
+            inside.extend(_scanline_intervals(poly, mid))
+        holes_at: list[tuple[float, float]] = []
+        for poly in holes:
