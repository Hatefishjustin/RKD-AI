+                    continue
+                data = zf.read(name)
+                if len(data) != entry.get("size_bytes"):
+                    problems.append(f"大小不一致：{name}")
+                if sha256_bytes(data) != entry.get("sha256"):
+                    problems.append(f"SHA 不一致：{name}")
+            extra = names - set(listed) - {"manifest.json"}
