+           "has_preserve": bool(preserve),
+           "preserve_object_ids": [o.get("object_ids") for o in preserve],
+           "preserve_binding": [o.get("binding_status") for o in preserve],
+           "has_aesthetic": any(o.get("kind") == "aesthetic" for o in objs)}
