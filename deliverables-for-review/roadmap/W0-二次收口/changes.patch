+    assert.equal(lastRun.task_kind, 'revise');
+    assert.equal(lastRun.status, 'succeeded');
+    const revs = (after.artifacts || []).filter(
+      a => a.kind === 'spatial-plan' && a.run_id === lastRun.id && a.revision >= 2);
