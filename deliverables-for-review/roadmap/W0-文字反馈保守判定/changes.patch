+        return 0 if result["passed"] else 1
+    finally:
+        main_server.shutdown(); main_server.server_close()
+        st_httpd.shutdown(); st_httpd.server_close()
+        main_thread.join(5); st_thread.join(5)
+        store.close()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
