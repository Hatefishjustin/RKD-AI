+"""W1 版本谱系收口：源谱系身份、父 UID 映射、导入顺序不伪造父链、写内并发重检。
+
+用法：
+  python scripts/verify_w1_lineage.py --out <dir> --runtime <dir>
+
+隔离主系统库 + 隔离 Studio 库；源是明确标记的本地夹具（真实 parent_revision_uid 链）。
+0 外部调用、0 密钥、0 费用。
+"""
+from __future__ import annotations
