+
+def check(cid: str, name: str, ok: bool, evidence: dict) -> None:
+    CHECKS.append({"id": cid, "name": name,
+                   "result": "observed_pass" if ok else "observed_fail",
+                   "evidence": evidence})
+    print(("PASS " if ok else "FAIL ") + cid + " " + name, flush=True)
