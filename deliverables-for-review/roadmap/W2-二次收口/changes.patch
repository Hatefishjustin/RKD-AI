+        tx.insert_job({"job_id": foreign_dev, "option_revision_id": rev["option_revision_id"],
+                       "adoption_version": 0, "input_hash": "0" * 64, "status": "running",
+                       "phase": "geometry", "attempt_count": 1, "settings": {},
