+             "deduction_basis": "keepouts_within_scope",
+             "areas": [{"object_id": "F1", "name": "解析三角材料面",
+                        "polygon_mm": polygon_mm, "unit": "m2",
+                        "material_ref": {"material_id": material, "name": "试验地坪"}}]}
+    scope.update(extra)
+    return scope
