+def _segments(points: list) -> list[tuple[tuple[float, float], tuple[float, float]]]:
+    n = len(points)
+    return [((float(points[i][0]), float(points[i][1])),
+             (float(points[(i + 1) % n][0]), float(points[(i + 1) % n][1])))
+            for i in range(n)]
