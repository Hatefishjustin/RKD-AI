{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rkd:contracts:ai-development-package:v1",
  "title": "AIDevelopmentPackageV1",
  "description": "A same-source development and quantity draft derived from one adopted AI design option. Not a formal quote, construction package, purchase order, or release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "production_revision_id", "job_id", "option_revision_id", "set_id", "option_id",
    "adoption_version", "input_hash", "created_at", "baseline", "boundary", "objects", "materials",
    "views", "quantity_items", "cost", "unknown_items", "measurement_rules", "status"
  ],
  "properties": {
    "schema_version": {"const": "rkd-ai-development-package.v1"},
    "production_revision_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "option_revision_id": {"type": "string", "minLength": 1},
    "set_id": {"type": "string", "minLength": 1},
    "option_id": {"type": "string", "minLength": 1},
    "adoption_version": {"type": "integer", "minimum": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "baseline": {"type": "object"},
    "boundary": {"type": "object"},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "views": {"type": "object"},
    "quantity_items": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cost": {"type": "object"},
    "unknown_items": {"type": "array", "items": {"type": "object"}},
    "measurement_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_status", "formal_quote", "external_effects_enabled", "procurement_status", "publication_status"],
      "properties": {
        "lifecycle_status": {"const": "draft"},
        "formal_quote": {"const": false},
        "external_effects_enabled": {"const": false},
        "procurement_status": {"const": "not_started"},
        "publication_status": {"const": "not_approved"}
      }
    }
  }
}
