{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rkd:contracts:command-registry:v1",
  "registry_version": "1.0",
  "purpose": "唯一命令名称、归属聚合、权限、幂等和领域事件注册表",
  "profiles": {
    "draft": {"risk_level": "low", "allowed_actor_types": ["agent:A1", "human:operator"], "side_effect": "none", "idempotency": "required"},
    "internal": {"risk_level": "medium", "allowed_actor_types": ["agent:A1", "agent:A2", "human:operator"], "side_effect": "internal", "idempotency": "required"},
    "external": {"risk_level": "high", "allowed_actor_types": ["agent:A3", "human:operator"], "side_effect": "external", "idempotency": "required", "authorization": "command-gateway-only"},
    "human-gate": {"risk_level": "critical", "allowed_actor_types": ["human:authorized-approver"], "side_effect": "business-fact", "idempotency": "required", "authorization": "separation-of-duties"}
  },
  "commands": {
    "CreateLeadDraft": {"aggregate": "Lead", "module": "commercial", "profile": "draft", "guard": "lead-source-present", "emits": ["lead.draft-created"]},
    "MergeLeadCandidates": {"aggregate": "Lead", "module": "commercial", "profile": "internal", "guard": "same-organization-and-merge-evidence", "emits": ["lead.merged"]},
    "CreateRequirementDraft": {"aggregate": "Requirement", "module": "requirements", "profile": "draft", "guard": "source-evidence-present", "emits": ["requirement.draft-created"]},
    "CreateClarificationTask": {"aggregate": "HumanTask", "module": "workflow", "profile": "internal", "guard": "blocking-unknown-present", "emits": ["clarification.requested"]},
    "RecordRequirementConflict": {"aggregate": "Requirement", "module": "requirements", "profile": "internal", "guard": "conflicting-evidence-present", "emits": ["requirement.conflict-detected"]},
    "CreateConflictResolutionTask": {"aggregate": "HumanTask", "module": "workflow", "profile": "internal", "guard": "unresolved-conflict-present", "emits": ["conflict-resolution.requested"]},
    "CreateDesignBriefDraft": {"aggregate": "DesignBrief", "module": "requirements", "profile": "draft", "guard": "requirements-structured-and-conflicts-addressed", "emits": ["brief.generated"]},
    "SubmitBriefForReview": {"aggregate": "DesignBrief", "module": "requirements", "profile": "internal", "guard": "brief-validation-passed", "emits": ["brief.review-requested"]},
    "CreateConceptOptionDraft": {"aggregate": "ConceptOption", "module": "concept", "profile": "draft", "guard": "brief-and-reference-evidence-present", "emits": ["concept-option.created"]},
    "CreateMaterialResearchTask": {"aggregate": "HumanTask", "module": "concept", "profile": "internal", "guard": "material-evidence-missing-or-uncertain", "emits": ["material-research.requested"]},
    "ComposeDesignIntent": {"aggregate": "DesignIntent", "module": "concept", "profile": "draft", "guard": "selected-concept-option-and-brief-version-match", "emits": ["design-intent.composed"]},
    "SelectConceptOption": {"aggregate": "ConceptOption", "module": "concept", "profile": "human-gate", "guard": "options-reviewed-and-client-direction-recorded", "emits": ["concept-option.selected"]},
    "ApproveDesignIntent": {"aggregate": "DesignIntent", "module": "concept", "profile": "human-gate", "guard": "selected-concept-option-and-brief-version-match", "emits": ["design-intent.approved"]},
    "CreateSiteDatasetDraft": {"aggregate": "SiteDataset", "module": "site", "profile": "draft", "guard": "uploaded-source-passed-security-scan", "emits": ["site-dataset.draft-created"]},
    "RequestRemeasurement": {"aggregate": "SiteDataset", "module": "site", "profile": "internal", "guard": "critical-geometry-missing-or-conflicted", "emits": ["remeasurement.requested"]},
