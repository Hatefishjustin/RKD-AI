    "CreateInternalTask": {"aggregate": "HumanTask", "module": "workflow", "profile": "internal", "guard": "owner-and-due-rule-present", "emits": ["internal-task.created"]},
    "CreateBlockRecord": {"aggregate": "BlockRecord", "module": "workflow", "profile": "internal", "guard": "blocking-condition-and-impact-present", "emits": ["block-record.created"]},
    "CreateFollowUpTask": {"aggregate": "HumanTask", "module": "workflow", "profile": "internal", "guard": "missing-response-or-evidence-present", "emits": ["follow-up.requested"]},
    "CreateProgressReportDraft": {"aggregate": "ProgressReport", "module": "site-ops", "profile": "draft", "guard": "site-evidence-and-work-package-present", "emits": ["progress-report.draft-created"]},
    "CreatePunchItem": {"aggregate": "PunchItem", "module": "site-ops", "profile": "draft", "guard": "defect-evidence-and-location-present", "emits": ["punch-item.created"]},
    "CreateInspectionDraft": {"aggregate": "Inspection", "module": "site-ops", "profile": "draft", "guard": "inspection-scope-and-checklist-present", "emits": ["inspection.draft-created"]},
    "CreateSiteIssue": {"aggregate": "SiteIssue", "module": "site-ops", "profile": "draft", "guard": "site-evidence-present", "emits": ["site-issue.reported"]},
    "RequestVerification": {"aggregate": "VerificationTask", "module": "site-ops", "profile": "internal", "guard": "claim-or-progress-evidence-requires-verification", "emits": ["verification.requested"]},
    "CreateChangeSetDraft": {"aggregate": "ChangeSet", "module": "change", "profile": "draft", "guard": "change-request-and-source-revision-present", "emits": ["change.requested"]},
    "QueueImpactAnalysis": {"aggregate": "ExecutorJob", "module": "change", "profile": "internal", "guard": "change-set-versioned-and-trace-links-available", "emits": ["change.impact-analysis-queued"]},
    "SubmitMinorChangeReview": {"aggregate": "ChangeSet", "module": "change", "profile": "internal", "guard": "impact-within-minor-change-policy", "emits": ["change.minor-review-requested"]},
    "RequestMissingDecisionEvidence": {"aggregate": "HumanTask", "module": "change", "profile": "internal", "guard": "decision-impact-cannot-be-verified", "emits": ["decision-evidence.requested"]},
    "CreateWarrantyTask": {"aggregate": "Warranty", "module": "handover", "profile": "draft", "guard": "handover-or-defect-evidence-present", "emits": ["warranty-task.created"]},
    "PrepareHandoverPackage": {"aggregate": "HandoverPackage", "module": "handover", "profile": "internal", "guard": "approved-deliverables-and-acceptance-record-present", "emits": ["handover-package.prepared"]},
    "CreateDecisionBriefDraft": {"aggregate": "DecisionBrief", "module": "governance", "profile": "draft", "guard": "decision-objective-and-evidence-present", "emits": ["decision-brief.draft-created"]},
    "EscalateException": {"aggregate": "Exception", "module": "governance", "profile": "internal", "guard": "unresolved-exception-and-owner-present", "emits": ["exception.escalated"]},
    "RescheduleInternalTask": {"aggregate": "HumanTask", "module": "workflow", "profile": "internal", "guard": "new-due-reason-and-owner-present", "emits": ["internal-task.rescheduled"]},
    "MarkReadyForG1": {"aggregate": "Approval", "module": "governance", "profile": "internal", "guard": "commercial-evidence-and-g1-checklist-passed", "emits": ["approval.requested"]},
    "SubmitG5": {"aggregate": "Approval", "module": "governance", "profile": "internal", "guard": "g5-purpose-and-target-revision-present", "emits": ["approval.requested"]}
  }
}
