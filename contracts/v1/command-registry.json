    "RecordOptionMetrics": {"aggregate": "SpatialOption", "module": "spatial", "profile": "internal", "guard": "deterministic-metrics-completed", "emits": ["spatial-option.metrics-recorded"]},
    "SelectOption": {"aggregate": "SpatialOption", "module": "spatial", "profile": "human-gate", "guard": "validated-option-and-authorized-designer", "emits": ["spatial-option.selected"]},
    "QueueBIMBuildJob": {"aggregate": "ExecutorJob", "module": "model", "profile": "internal", "guard": "spatial-plan-approved-for-model", "emits": ["bim.generation-started"]},
    "CreateProductionBatch": {"aggregate": "ProductionBatch", "module": "production", "profile": "internal", "guard": "approved-baseline-and-model-manifest-present", "emits": ["production-batch.created"]},
    "RecordExternalObjectMapping": {"aggregate": "ObjectMapping", "module": "model", "profile": "internal", "guard": "source-and-target-revisions-present", "emits": ["model.mapping-recorded"]},
    "CreateModelCorrectionTask": {"aggregate": "HumanTask", "module": "model", "profile": "internal", "guard": "model-validation-issue-present", "emits": ["model.correction-requested"]},
    "QueueSceneBuildJob": {"aggregate": "ExecutorJob", "module": "render", "profile": "internal", "guard": "validated-model-and-design-intent-present", "emits": ["scene-build.queued"]},
    "QueueRenderJob": {"aggregate": "ExecutorJob", "module": "render", "profile": "internal", "guard": "scene-and-camera-checks-passed", "emits": ["render.queued"]},
    "CreateRenderCorrectionTask": {"aggregate": "HumanTask", "module": "render", "profile": "internal", "guard": "render-quality-issue-present", "emits": ["render.correction-requested"]},
    "QueueDrawingJob": {"aggregate": "ExecutorJob", "module": "drawing", "profile": "internal", "guard": "validated-model-and-drawing-rules-present", "emits": ["drawing-set.generated"]},
    "CreateDrawingCorrectionTask": {"aggregate": "HumanTask", "module": "drawing", "profile": "internal", "guard": "drawing-check-failed", "emits": ["drawing.correction-requested"]},
    "MarkDrawingReleaseCandidate": {"aggregate": "DrawingSet", "module": "drawing", "profile": "internal", "guard": "blocking-drawing-errors-cleared-or-exception-approved", "emits": ["drawing-set.release-candidate-created"]},
    "QueueValidationJob": {"aggregate": "ExecutorJob", "module": "quality", "profile": "internal", "guard": "validation-profile-and-target-revision-present", "emits": ["validation.queued"]},
    "CreateTechnicalIssue": {"aggregate": "TechnicalIssue", "module": "quality", "profile": "internal", "guard": "failed-or-not-run-blocking-check", "emits": ["technical-issue.created"]},
    "RequestRuleExceptionReview": {"aggregate": "Exception", "module": "quality", "profile": "internal", "guard": "rule-identified-and-impact-recorded", "emits": ["rule-exception.review-requested"]},
    "QueueQuantityTakeoff": {"aggregate": "ExecutorJob", "module": "commercial", "profile": "internal", "guard": "model-revision-and-measurement-rules-present", "emits": ["boq.quantity-takeoff-queued"]},
    "QueuePriceCalculation": {"aggregate": "ExecutorJob", "module": "commercial", "profile": "internal", "guard": "price-snapshot-and-formula-version-present", "emits": ["quote.calculation-queued"]},
    "CreateQuoteDraft": {"aggregate": "Quote", "module": "commercial", "profile": "draft", "guard": "boq-and-price-results-present", "emits": ["quote.draft-created"]},
    "CreateCommercialIssue": {"aggregate": "CommercialIssue", "module": "commercial", "profile": "internal", "guard": "commercial-risk-or-missing-basis-present", "emits": ["commercial-issue.created"]},
    "CreateContractDraft": {"aggregate": "Contract", "module": "finance", "profile": "draft", "guard": "accepted-quote-and-contract-template-present", "emits": ["contract.draft-created"]},
    "CreateInvoiceDraft": {"aggregate": "Invoice", "module": "finance", "profile": "draft", "guard": "contract-or-purchase-basis-and-tax-context-present", "emits": ["invoice.draft-created"]},
    "CreateCostEntryDraft": {"aggregate": "CostEntry", "module": "finance", "profile": "draft", "guard": "actual-cost-evidence-present", "emits": ["cost-entry.draft-created"]},
    "RequestReconciliation": {"aggregate": "Reconciliation", "module": "finance", "profile": "internal", "guard": "external-statement-and-ledger-scope-present", "emits": ["reconciliation.requested"]},
    "CreateRFQDraft": {"aggregate": "RFQ", "module": "procurement", "profile": "draft", "guard": "approved-spec-and-quantity-present", "emits": ["rfq.draft-created"]},
    "CreatePurchaseOrderDraft": {"aggregate": "PurchaseOrder", "module": "procurement", "profile": "draft", "guard": "approved-spec-supplier-and-price-present", "emits": ["purchase-order.draft-created"]},
    "SubmitApprovedPurchaseOrder": {"aggregate": "PurchaseOrder", "module": "procurement", "profile": "external", "guard": "human-approval-and-reconciliation-plan-present", "emits": ["purchase-order.submission-requested"]},
