{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkd.local/contracts/v1/realmodel-spatial-adaptation.schema.json",
  "title": "Real-model output shape -> versioned spatial adaptation contract",
  "description": "评审用独立适配契约：约束离线真实模型输出形状到 rkd-realmodel-spatial.v1 的映射。 此契约只描述适配器输入输出与字段口径，不替代 ai-design-option.schema.json； 适配产物仍须通过主契约校验才可进入任何候选/采用链。 0 外部调用、unknown 不填 0、矩形四角化不冒称非矩形能力、curved_intent 不生成弧墙、 v2 底图按 SHA 对账、W2 人工表达与真实来源分离。",
  "type": "object",
  "required": [
    "contract_version",
    "adapter_version",
    "spatial_version",
    "mapping_version",
    "vocab_version",
    "basemap",
    "vocabularies",
    "rules",
    "negative_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "rkd-realmodel-spatial-adaptation.v2"
    },
    "adapter_version": {
      "const": "rkd-realmodel-spatial-adapter.v2"
    },
    "spatial_version": {
      "const": "rkd-realmodel-spatial.v2"
    },
    "mapping_version": {
      "const": "realmodel-output-to-spatial.v2"
    },
    "vocab_version": {
      "const": "rkd-design-vocab.v1"
    },
    "basemap": {
      "type": "object",
      "required": [
        "contract_version",
        "boundary_mm",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "rkd-site-basemap.v2"
        },
        "boundary_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "files": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "required": [
        "zone_role",
        "furniture_type",
        "wall_type",
        "sequence_role"
      ],
      "additionalProperties": false,
      "properties": {
        "zone_role": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "furniture_type": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "wall_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sequence_role": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "object_identity",
        "coordinate_units",
        "geometry_mode",
        "curved_intent",
        "parent_chain",
        "source_separation",
        "unknown_policy",
        "version_reconciliation",
        "expression_separation",
        "structured_basemap_binding",
        "verifiable_source",
        "axis_fidelity",
        "final_package_render"
      ],
      "additionalProperties": false,
      "properties": {
        "object_identity": {
          "type": "string"
        },
        "coordinate_units": {
          "type": "string"
        },
        "geometry_mode": {
          "type": "string"
        },
        "curved_intent": {
          "type": "string"
        },
        "parent_chain": {
          "type": "string"
        },
        "source_separation": {
          "type": "string"
        },
        "unknown_policy": {
          "type": "string"
        },
        "version_reconciliation": {
          "type": "string"
        },
        "expression_separation": {
          "type": "string"
        },
        "structured_basemap_binding": {
          "type": "string"
        },
        "verifiable_source": {
          "type": "string"
        },
        "axis_fidelity": {
          "type": "string"
        },
        "final_package_render": {
          "type": "string"
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "expect",
          "before",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "expect": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        }
      }
    }
  }
}
