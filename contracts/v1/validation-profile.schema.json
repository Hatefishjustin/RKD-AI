{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rkd:contracts:validation-profile:v1",
  "title": "ValidationProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "version", "profile_hash", "domain", "checks", "exception_policy"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"},
    "domain": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}, "minItems": 1},
    "exception_policy": {"$ref": "#/$defs/exceptionPolicy"}
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "description", "scope", "severity", "blocking", "measurement", "implementation_ref"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "warning", "error", "critical"]},
        "blocking": {"type": "boolean"},
        "measurement": {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "operator", "threshold", "unit"],
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "operator": {"type": "string", "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "between", "contains"]},
            "threshold": {},
            "unit": {"type": "string", "minLength": 1},
            "tolerance": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "coverage_denominator": {"type": ["string", "null"]},
        "implementation_ref": {"type": "string", "minLength": 1}
      }
    },
    "exceptionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "required_role", "expires_required"],
      "properties": {
        "allowed": {"type": "boolean"},
        "required_role": {"type": ["string", "null"]},
        "expires_required": {"type": "boolean"}
      }
    }
  }
}
