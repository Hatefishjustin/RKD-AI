{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkd.local/contracts/v1/spatial-plan-draft.schema.json",
  "title": "Spatial plan draft (studio agent hand-off)",
  "description": "Agent 之间交接的空间规划草案。单位统一 mm；面积用 ㎡。这是 versioned hand-off，不是最终出图数据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "project_id", "option_id", "revision", "strategy",
    "zones", "circulation", "furniture", "area_table", "open_questions"
  ],
  "properties": {
    "contract_version": { "const": "rkd-spatial-plan.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "option_id": { "type": "string", "pattern": "^[A-Z]$" },
    "revision": { "type": "integer", "minimum": 1 },
    "parent_revision": { "type": ["integer", "null"] },
    "author": { "type": "string" },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "narrative", "tradeoffs", "non_orthogonal"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "narrative": { "type": "string", "minLength": 20 },
        "tradeoffs": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "non_orthogonal": {
          "type": "array", "minItems": 2,
          "items": { "type": "string" },
          "description": "非直角元素清单，至少 2 条（圆角、弧墙、斜置等）"
        }
      }
    },
    "zones": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "polygon", "area_sqm"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 2 },
          "role": {
            "type": "string",
            "enum": ["arrival", "gallery", "island", "scene", "meeting", "service", "circulation", "support"]
          },
          "polygon": {
            "type": "array", "minItems": 3,
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "area_sqm": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "circulation": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width_mm", "path"],
        "properties": {
          "id": { "type": "string" },
          "width_mm": { "type": "number", "minimum": 900 },
          "path": {
            "type": "array", "minItems": 2,
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "polygon", "height_mm"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["rounded", "polygon", "stepped"] },
          "corner_radius_mm": { "type": "number", "minimum": 0 },
          "polygon": {
            "type": "array", "minItems": 3,
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "height_mm": { "type": "number", "minimum": 0 }
        }
      }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string" },
        "coves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "polygon"],
            "properties": {
              "id": { "type": "string" },
              "polygon": {
                "type": "array", "minItems": 3,
                "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              },
              "band_mm": { "type": "number" },
              "kelvin": { "type": "number" }
            }
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "x", "y"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["downlight", "spot", "linear", "pendant", "wallwasher"] },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "kelvin": { "type": "number" },
              "aim": { "type": "string" }
            }
          }
        }
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "catalog_id", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "catalog_id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "rot": { "type": "number" },
          "w_mm": { "type": "number" },
          "d_mm": { "type": "number" }
        }
      }
    },
    "area_table": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "area_sqm"],
        "properties": {
          "name": { "type": "string" },
          "area_sqm": { "type": "number", "minimum": 0 }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "standards_cited": { "type": "array", "items": { "type": "string" } }
  }
}
