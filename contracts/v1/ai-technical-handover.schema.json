{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkd-ai.local/contracts/v1/ai-technical-handover.schema.json",
  "title": "RKD AI technical handover draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "production_revision_id", "option_revision_id",
               "adoption_version", "input_hash", "baseline", "delivery_depth", "supported_scope",
               "unsupported_scope", "source_extractions", "object_ids", "quantity_item_ids",
               "review_tasks", "status"],
  "properties": {
    "schema_version": {"const": "rkd-ai-technical-handover.v1"},
    "delivery_id": {"type": "string", "minLength": 1},
    "production_revision_id": {"type": "string", "minLength": 1},
    "option_revision_id": {"type": "string", "minLength": 1},
    "adoption_version": {"type": "integer", "minimum": 0},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": "object"},
    "delivery_depth": {"const": "technical_draft_not_construction_documents"},
    "supported_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "statement", "status", "basis"],
        "properties": {
          "scope_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "supported_intent_only"]},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "unsupported_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "statement", "reason", "value", "known_status", "source_refs"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "value": {"type": "null"},
          "known_status": {"const": "unknown"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "source_extractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extraction_id", "file_id", "filename", "status", "segment_count", "file_sha256"],
        "properties": {
          "extraction_id": {"type": "string", "minLength": 1},
          "file_id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "segment_count": {"type": "integer", "minimum": 0},
          "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "quantity_item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role", "statement", "status"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"const": "pending"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["professional_review", "formal_quote", "construction_issue", "publication_status",
                   "external_effects_enabled", "purchase_order"],
      "properties": {
        "professional_review": {"const": "pending"},
        "formal_quote": {"const": false},
        "construction_issue": {"const": false},
        "publication_status": {"const": "not_approved"},
        "external_effects_enabled": {"const": false},
        "purchase_order": {"const": "not_started"}
      }
    }
  }
}
