{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rkd:contracts:agent-task:v1",
  "title": "AgentTaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "schema_hash", "task_spec_hash", "task_id", "package_id",
    "agent_type", "agent_version", "organization_id", "project_id",
    "project_context_version", "capability_pack_version", "workflow_version",
    "correlation_id", "causation", "idempotency_key", "risk_level",
    "data_classification", "goal", "input_refs", "constraints", "acceptance_rules",
    "allowed_tools", "allowed_command_types", "output_schema_ref", "output_schema_hash", "created_at"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "schema_hash": {"$ref": "#/$defs/hash"},
    "task_spec_hash": {"$ref": "#/$defs/hash"},
    "task_id": {"type": "string", "format": "uuid"},
    "package_id": {"type": "string", "format": "uuid"},
    "agent_type": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "project_context_version": {"type": "integer", "minimum": 1},
    "capability_pack_version": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "rule_set_versions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation": {"$ref": "#/$defs/causation"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "data_classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
    "goal": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"$ref": "#/$defs/inputRef"}, "minItems": 1},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}, "default": []},
    "acceptance_rules": {"type": "array", "items": {"$ref": "#/$defs/acceptanceRule"}, "minItems": 1},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_command_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "output_schema_hash": {"$ref": "#/$defs/hash"},
    "cost_budget": {"$ref": "#/$defs/costBudget"},
    "deadline_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:+._-]{7,255}$"},
    "causation": {
      "type": "object", "additionalProperties": false, "required": ["source_type", "source_id"],
      "properties": {
        "source_type": {"type": "string", "enum": ["event", "command", "human-task", "manual"]},
        "source_id": {"type": "string", "format": "uuid"}
      }
    },
    "inputRef": {
      "type": "object", "additionalProperties": false,
      "required": ["object_type", "object_id", "revision_id", "content_hash"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "format": "uuid"},
        "revision_id": {"type": "string", "format": "uuid"},
        "artifact_id": {"type": ["string", "null"], "format": "uuid"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "kind", "statement", "blocking"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["business", "technical", "safety", "cost", "schedule", "data", "tool"]},
        "statement": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "source_ref": {"type": ["string", "null"]}
      }
    },
    "acceptanceRule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "description", "validation_method", "blocking"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "validation_method": {"type": "string", "enum": ["schema", "deterministic", "professional", "human-approval"]},
        "blocking": {"type": "boolean"},
        "validation_profile_ref": {"type": ["string", "null"]}
      }
    },
    "costBudget": {
      "type": "object", "additionalProperties": false, "required": ["currency", "max_amount"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "max_amount": {"type": "number", "minimum": 0},
        "max_tokens": {"type": ["integer", "null"], "minimum": 0},
        "max_runtime_seconds": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
