{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rkd:contracts:cad-plan-candidates:v1",
  "title": "CadPlanCandidatesV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "profile_id", "source_asset_id", "source_sha256",
    "semantic_mapping_version", "status", "target_region", "summary",
    "candidates", "warnings"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "source_asset_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "semantic_mapping_version": {"type": "string", "minLength": 1},
    "status": {"const": "candidate-extraction-complete"},
    "target_region": {"$ref": "#/$defs/targetRegion"},
    "summary": {"$ref": "#/$defs/summary"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/point"},
        "maximum": {"$ref": "#/$defs/point"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "targetRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_space", "units", "bounds", "size", "anchor_evidence",
        "corroborating_evidence", "construction_verification_status"
      ],
      "properties": {
        "coordinate_space": {"const": "dwg-model-space"},
        "units": {"type": "string", "minLength": 1},
        "bounds": {"$ref": "#/$defs/bounds"},
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number", "exclusiveMinimum": 0},
            "y": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "anchor_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "corroborating_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "construction_verification_status": {
          "const": "drawing-cross-checked-not-site-verified"
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_model_candidate_count", "current_scope_candidate_count",
        "excluded_scope_candidate_count", "other_non_current_scope_candidate_count",
        "scope_disposition_candidate_counts", "block_insertion_candidate_count",
        "block_expansion_status_counts",
        "category_candidate_counts", "layer_candidate_counts", "outside_region_counts",
        "skipped_without_coordinate_counts", "nested_block_geometry_status",
        "user_confirmation_required_now"
      ],
      "properties": {
        "direct_model_candidate_count": {"type": "integer", "minimum": 0},
        "current_scope_candidate_count": {"type": "integer", "minimum": 0},
        "excluded_scope_candidate_count": {"type": "integer", "minimum": 0},
        "other_non_current_scope_candidate_count": {"type": "integer", "minimum": 0},
        "scope_disposition_candidate_counts": {"$ref": "#/$defs/countMap"},
        "block_insertion_candidate_count": {"type": "integer", "minimum": 0},
        "block_expansion_status_counts": {"$ref": "#/$defs/countMap"},
        "category_candidate_counts": {"$ref": "#/$defs/countMap"},
        "layer_candidate_counts": {"$ref": "#/$defs/countMap"},
        "outside_region_counts": {"$ref": "#/$defs/countMap"},
        "skipped_without_coordinate_counts": {"$ref": "#/$defs/countMap"},
        "nested_block_geometry_status": {
          "enum": ["not-applicable", "expanded", "expanded-with-partial-candidates", "not-expanded"]
        },
        "user_confirmation_required_now": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "source_entity_handle", "source_entity_type", "source_layer",
        "category", "scope_disposition", "mapping_confidence", "bounds", "point_count",
        "geometry_points", "source_geometry_closed", "geometry_status",
        "requires_block_expansion", "eligible_for_current_scope"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^cadcand-[a-f0-9]{24}$"},
        "source_entity_handle": {"type": "integer", "minimum": 0},
        "source_entity_type": {"type": "string", "minLength": 1},
        "source_layer": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "scope_disposition": {"type": "string", "minLength": 1},
        "mapping_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bounds": {"$ref": "#/$defs/bounds"},
        "point_count": {"type": "integer", "minimum": 1},
        "geometry_points": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}
        },
        "source_geometry_closed": {"type": ["boolean", "null"]},
        "geometry_status": {
          "enum": [
            "direct-model-geometry-candidate", "block-expanded-geometry-candidate",
            "block-partially-expanded-geometry-candidate", "block-insertion-point-only"
          ]
        },
        "requires_block_expansion": {"type": "boolean"},
        "eligible_for_current_scope": {"type": "boolean"},
        "referenced_block_handle": {"type": ["integer", "null"], "minimum": 0},
        "root_insertion_point": {
          "oneOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]
        },
        "block_expansion": {"$ref": "#/$defs/blockExpansion"}
      }
    },
    "blockExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "expanded_point_count", "leaf_entity_count",
        "leaf_entity_type_counts", "skipped_leaf_entity_type_counts",
        "issue_counts", "maximum_nested_depth"
      ],
      "properties": {
        "status": {"enum": ["expanded", "partially-expanded", "not-expanded"]},
        "expanded_point_count": {"type": "integer", "minimum": 0},
        "leaf_entity_count": {"type": "integer", "minimum": 0},
        "leaf_entity_type_counts": {"$ref": "#/$defs/countMap"},
        "skipped_leaf_entity_type_counts": {"$ref": "#/$defs/countMap"},
        "issue_counts": {"$ref": "#/$defs/countMap"},
        "maximum_nested_depth": {"type": "integer", "minimum": 1}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
