    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT issue_no, project_no, severity, assignee, deadline, overdue_count, needs_boss_approval FROM issues WHERE status NOT IN ('已关闭','待整理') AND deadline < CURRENT_TIMESTAMP ORDER BY deadline",
        "options": {}
      },
      "id": "a15",
      "name": "查逾期未关闭问题",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -140,
        420
      ],
      "credentials": {
        "postgres": {
          "id": "PG_MAIN",
          "name": "公司主数据库"
        }
