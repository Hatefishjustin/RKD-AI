      "webhookId": "issue-submit"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 预校验：必填项缺失直接报错，不进入AI\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const b = it.json.body || it.json;\n  if (!b.project_no || !b.description) {\n    throw new Error('缺少 project_no 或 description，拒绝入库：' + JSON.stringify(b).slice(0, 200));\n  }\n  out.push({ json: { ...b, found_at: b.found_at || new Date().toISOString(), photos: b.photos || [] } });\n}\nreturn out;"
      },
      "id": "a2",
      "name": "预校验输入",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_API_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL, messages: [ { role: 'system', content: '你是室内设计公司的施工问题助理。输入现场提交的问题描述与照片说明，只输出JSON：{\"issue_type\":\"尺寸|材料|工艺|质量|进度|安全|图纸|客户变更|其他\",\"severity\":\"一般|重要|紧急\",\"description\":\"位置+现象+依据，≤80字\",\"affects_design\":bool,\"affects_cost\":bool,\"affects_schedule\":bool,\"needs_drawing_change\":bool,\"responsible_party\":\"施工方|供应商|设计方|客户|物业\",\"confidence\":0.00}。判定：紧急=安全风险/停工/影响关键节点；重要=影响设计效果或需返工；一般=可随工序修复。不确定的字段置null并在description前加[待补充]，禁止编造。' }, { role: 'user', content: JSON.stringify($json) } ], temperature: 0.2 }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a3",
      "name": "AI整理-施工问题助理",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 解析AI结果，计算默认截止时间与置信度标记\nconst out = [];\nfor (const it of $input.all()) {\n  const ai = it.json.choices?.[0]?.message?.content || it.json.content || '';\n  let parsed;\n  try { parsed = JSON.parse(String(ai).replace(/^```json?|```$/g, '').trim()); }\n  catch (e) { throw new Error('AI输出解析失败，原文转待整理队列：' + String(ai).slice(0, 300)); }\n  const src = $('预校验输入').first().json;\n  const hours = { '紧急': 24, '重要': 72, '一般': 168 };\n  const sev = parsed.severity || '一般';\n  const deadline = new Date(Date.now() + (hours[sev] || 168) * 3600 * 1000);\n  const needsBoss = sev === '紧急' || (sev === '重要' && (parsed.affects_design || parsed.affects_cost || parsed.affects_schedule));\n  // 责任人映射：尺寸/图纸→施工图设计师；材料/工艺/质量→施工方+采购；进度→采购责任人；客户变更→老板\n  const assignMap = { '尺寸': '施工图设计师', '图纸': '施工图设计师', '材料': '采购责任人', '工艺': '采购责任人', '质量': '采购责任人', '进度': '采购责任人', '客户变更': '老板' };\n  out.push({ json: { ...src, ...parsed, deadline: deadline.toISOString(), needs_boss_approval: needsBoss,\n    assignee: src.assignee || assignMap[parsed.issue_type] || '采购责任人',\n    low_confidence: (parsed.confidence ?? 0) < 0.7 } });\n}\nreturn out;"
      },
      "id": "a4",
      "name": "解析与编号规则",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.low_confidence }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a5",
      "name": "置信度≥0.7?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        580,
        0
      ]
    },
