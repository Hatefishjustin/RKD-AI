    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 逾期分级：逾期1天催办、3天升级；无逾期发正常简报\nconst rows = $input.all().map(i => i.json);\nconst now = Date.now();\nlet md = '';\nconst escalated = [];\nfor (const r of rows) {\n  const days = Math.floor((now - new Date(r.deadline).getTime()) / 86400000);\n  if (days >= 3 || r.overdue_count >= 2) escalated.push(r);\n  md += `- ${r.issue_no}（${r.severity}）责任：${r.assignee}，逾期${days}天\\n`;\n}\nif (!rows.length) md = '- 全部问题按期处理中，无逾期';\nreturn [{ json: { report: '### 施工问题巡检 ' + new Date().toISOString().slice(0, 10) + '\\n' + md, escalated, count: rows.length } }];"
      },
